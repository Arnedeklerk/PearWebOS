#!/bin/sh
# pearwebos: the on-TV side of PearWebOS.
#
# Two ways in, by what LG's Home is ($DIR/mode, written by the installer):
#  - qml (webOS 6): Pear is mounted into LG Home, as below.
#  - app (webOS 10, whose Home is Flutter): Pear is an app of its own,
#    org.pearwebos.home (web/), and homeguard opens it whenever LG's Home
#    comes to the front. Nothing of LG's is touched.
#
# Files under $DIR/files mirror LG Home's qml/ tree and are bind-mounted over
# the stock ones; nothing on the read-only system changes, and `off` (or a
# reboot with the hook removed) is stock LG Home again.
#
# LG Home is restored from snapshots with its QML already loaded, so mounting
# files changes nothing until Home cold starts:
#  - a relaunch restores the CRIU snapshot in $CKPT, which the app manager
#    retakes after a cold start with whatever is mounted then;
#  - a full boot restores LG's quick-start image, which holds stock Home.
# So every boot rebuilds Home with Pear. (The hook runs only on a real boot,
# not a Quick Start+ resume. Nothing else tells the two apart: the image
# carries the same pid, snapshot and even kernel boot_id every time.)
# $STAMP records the Home Pear last started, for `status`.
#
#   pearwebos on      mount, cold-start Home, check it came up
#   pearwebos off     unmount, cold-start stock Home, and stay off at boot
#   pearwebos boot    what the init.d hook runs
#   pearwebos status
#   pearwebos settings  the power-on settings chosen in setup
#   pearwebos unmount   before replacing the files (the installer)
#   pearwebos install-app <ipk> | remove-app   Pear's own app, in app mode

DIR=/var/lib/pearwebos
APP=/usr/palm/applications/com.webos.app.home/qml
CKPT=/mnt/lg/cmn_data/checkpoint/com.webos.app.home
STAMP=$DIR/checkpoint.stamp
OFF=$DIR/disabled
LOG=$DIR/pearwebos.log
LS=$DIR/luna-send-n
MODE=$(cat "$DIR/mode" 2>/dev/null)
PEAR_APP=org.pearwebos.home
PEAR_APP_DIR=/media/developer/apps/usr/palm/applications/$PEAR_APP

# choices from `pear setup`
GUARD=1 BOOT_TO_HOME=1 QUICK_START=1 NO_UPDATE_PROMPT=1
[ -f "$DIR/pear.conf" ] && . "$DIR/pear.conf"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" | tee -a "$LOG" >&2
    tail -n 300 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
}

# relative paths of every Pear file (none in app mode)
pear_files() { [ -d "$DIR/files" ] && (cd "$DIR/files" && find . -type f | sed 's|^\./||'); }

mounted() { grep -q " $1 " /proc/mounts; }

mount_all() {
    for f in $(pear_files); do
        t=$APP/$f
        [ -f "$t" ] || { log "no stock file for $f; skipped"; continue; }
        mounted "$t" || mount --bind "$DIR/files/$f" "$t" || log "mount failed: $f"
    done
}

umount_all() {
    for f in $(pear_files); do
        t=$APP/$f
        while mounted "$t"; do umount "$t" || break; done
    done
}

home_pid() { ps -eo pid,args | grep '[/]usr/bin/com.webos.app.home' | awk '{print $1}' | head -1; }

# which Home this is: its pid (kept across CRIU restores), the snapshot, and
# the boot. Pid and snapshot alone can repeat: a full boot starts things in
# the same order, so LG's stock Home often gets the very pid Pear's had, and
# looked like it (#13). The boot id is new at every boot, and a full boot
# always brings LG's own Home; Quick Start+ resumes keep it.
pear_id() { echo "$(home_pid) $([ -d "$CKPT" ] && stat -c '%Y-%i' "$CKPT" 2>/dev/null)"; }

open_home() { $LS -n 1 luna://com.webos.applicationManager/launch '{"id":"com.webos.app.home"}' >/dev/null; }

guard() { [ "$GUARD" = 1 ] && "$DIR/homeguard" "$1"; }

# ---- app mode: Pear as its own app ----

open_pear() { $LS -n 1 luna://com.webos.applicationManager/launch "{\"id\":\"$PEAR_APP\"}" >/dev/null; }

# through the same service Homebrew Channel installs with; done when its
# subscription says so (or after two minutes)
install_app() {
    /usr/bin/luna-send -i luna://com.webos.appInstallService/dev/install \
        "{\"id\":\"com.ares.defaultName\",\"ipkUrl\":\"$1\",\"subscribe\":true}" >"$DIR/install.log" 2>&1 &
    pid=$!
    i=0
    while [ $i -lt 120 ]; do
        grep -qi '"state": *"installed"\|"returnValue": *false\|"state": *"[^"]*fail' "$DIR/install.log" && break
        kill -0 "$pid" 2>/dev/null || break
        sleep 1; i=$((i + 1))
    done
    kill "$pid" 2>/dev/null
    if grep -qi '"state": *"installed"' "$DIR/install.log"; then
        log "app: $PEAR_APP $(cat "$DIR/VERSION" 2>/dev/null) installed"
    else
        log "app: install didn't finish: $(tr '\n' ' ' < "$DIR/install.log" | cut -c1-300)"
        return 1
    fi
}

remove_app() {
    $LS -n 1 luna://com.webos.appInstallService/dev/remove "{\"id\":\"$PEAR_APP\"}" >/dev/null
}

# from qml mode to app mode (PEAR_MODE=app on webOS 6): LG Home's snapshot
# still holds Pear's QML, so start it from its own files once
leave_qml() { [ -f "$STAMP" ] && { log "app: putting LG's Home back to stock first"; go_stock; }; true; }

app_on() {
    rm -f "$OFF"
    leave_qml
    peard start
    "$DIR/homeguard" start
    open_pear
    log "on: Pear's app up"
}

app_off() {
    touch "$OFF"
    leave_qml
    "$DIR/homeguard" stop
    peard stop
    open_home
    log "off: LG's Home"
}

# homeguard swaps LG's Home for Pear from its first look at the screen
app_boot() {
    [ -f "$OFF" ] && { log "boot: off"; return 0; }
    peard start
    "$DIR/homeguard" start
    log "boot: Pear's app on watch"
    boot_settings
}

app_status() {
    [ -f "$OFF" ] && echo "state: off" || echo "state: on (app mode)"
    v=$(grep -o '"version": *"[^"]*"' "$PEAR_APP_DIR/appinfo.json" 2>/dev/null | cut -d'"' -f4)
    echo "app: ${v:-not installed}"
    [ -f "$DIR/homeguard.pid" ] && kill -0 "$(cat "$DIR/homeguard.pid")" 2>/dev/null &&
        echo "homeguard: running" || echo "homeguard: not running"
}

# peard: what Pear's Home asks for settings, photos, inputs and weather
peard() {
    case "$1" in
        start)
            peard stop
            setsid node "$DIR/peard.js" </dev/null >>"$DIR/peard.log" 2>&1 &
            echo $! > "$DIR/peard.pid" ;;
        stop)
            [ -f "$DIR/peard.pid" ] && kill "$(cat "$DIR/peard.pid")" 2>/dev/null
            rm -f "$DIR/peard.pid" ;;
    esac
}

# Throw away the snapshot and start Home from its files. Returns as soon as
# the new Home is running: every second here is a second of stock Home on
# screen. Non-zero if none came up within 10 s.
cold_start() {
    rm -rf "$CKPT"
    pid=$(home_pid)
    if [ -n "$pid" ]; then
        kill "$pid"
        i=0
        while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do usleep 100000; i=$((i + 1)); done
    fi
    open_home
    i=0
    while [ -z "$(home_pid)" ] && [ $i -lt 100 ]; do usleep 100000; i=$((i + 1)); done
    [ -n "$(home_pid)" ]
}

# Then wait for the app manager to snapshot the new Home, and check it stayed
# up. Only the stamp needs this, so at boot it runs with Pear already showing.
wait_snapshot() {
    i=0
    while [ ! -d "$CKPT" ] && [ $i -lt 30 ]; do sleep 1; i=$((i + 1)); done
    sleep 8
    [ -n "$(home_pid)" ] && [ -d "$CKPT" ]
}

# nothing but Live TV (or nothing) in front
front_is_bare() {
    ids=$($LS -n 1 luna://com.webos.applicationManager/getForegroundAppInfo '{"extraInfo":true}' |
          grep -o '"appId": *"[^"]*"' | grep -v -e '"appId": *"com.webos.app.livetv"' -e '"appId": *""')
    [ -z "$ids" ]
}

go_stock() {
    umount_all
    cold_start && wait_snapshot
    rm -f "$STAMP"
}

cmd_on() {
    rm -f "$OFF"
    peard start
    # remount: a replaced file is a new inode, and a mount keeps the old one
    umount_all
    mount_all
    if cold_start && wait_snapshot; then
        pear_id > "$STAMP"
        guard start
        log "on: Pear Home up (snapshot $(cat "$STAMP"))"
    else
        log "on: Home did not stay up with Pear; back to stock"
        go_stock
        touch "$OFF"
        return 1
    fi
}

cmd_off() {
    touch "$OFF"
    peard stop
    "$DIR/homeguard" stop
    go_stock
    log "off: stock Home"
}

# the settings a TV needs to power on straight into Home
boot_settings() {
    # off sets them back too: power-on then shows the last input, not Home
    if [ "$BOOT_TO_HOME" = 1 ]; then
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"general","settings":{"powerOnScreen":"liveTv","welcomeFeature":"off","noSignalScreenSaver":"off","homeAutoLaunch":"on","homeAutoLaunchMode":"full"}}' >/dev/null
    else
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"general","settings":{"powerOnScreen":"liveTv","homeAutoLaunch":"off"}}' >/dev/null
    fi
    # Quick Start+: power-off sleeps, so power-on resumes Pear instead of
    # booting LG's stock Home
    [ "$QUICK_START" = 1 ] &&
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"option","settings":{"quickStartMode":"on"}}' >/dev/null
    # no "new software, update now?" at power-on: an update can remove root
    [ "$NO_UPDATE_PROMPT" = 1 ] &&
        $LS -n 1 luna://com.webos.settingsservice/setSystemSettings '{"category":"support","settings":{"automaticUpdate":"off","softwareUpdateEnable":"false"}}' >/dev/null
    return 0
}

cmd_boot() {
    [ -f "$OFF" ] && { log "boot: off"; return 0; }
    mount_all
    peard start
    # a boot always brings LG's stock Home: rebuild it with Pear at once, so
    # the stock one is on screen as briefly as possible
    log "boot: rebuilding Home with Pear ($(pear_id))"
    # the files are mounted above; Pear is on screen once cold_start returns
    cold_start && guard start
    # bookkeeping, after Pear is already showing
    if wait_snapshot; then
        pear_id > "$STAMP"
        log "boot: Pear Home up (snapshot $(cat "$STAMP"))"
        # Home is an overlay: bring it up over a bare Live TV, but don't pull
        # anyone out of an app they opened meanwhile
        [ "$BOOT_TO_HOME" = 1 ] && front_is_bare && open_home
    else
        log "boot: Home did not stay up with Pear; back to stock"
        "$DIR/homeguard" stop
        go_stock
        touch "$OFF"
        return 1
    fi
    boot_settings
}

cmd_status() {
    [ -f "$OFF" ] && echo "state: off" || echo "state: on"
    echo "home pid: $(home_pid)"
    echo "running: $(pear_id)  pear: $(cat "$STAMP" 2>/dev/null)"
    for f in $(pear_files); do
        mounted "$APP/$f" && echo "  mounted  $f" || echo "  -        $f"
    done
}

if [ "$MODE" = app ]; then
    case "${1:-status}" in
        on) app_on; exit ;;
        off) app_off; exit ;;
        boot) app_boot; exit ;;
        status) app_status; exit ;;
    esac
fi

case "${1:-status}" in
    on) cmd_on ;;
    off) cmd_off ;;
    boot) cmd_boot ;;
    status) cmd_status ;;
    install-app) install_app "$2" ;;
    remove-app) remove_app ;;
    settings) boot_settings ;;
    unmount) umount_all ;;
    *) echo "usage: pearwebos on|off|boot|status|settings|unmount|install-app <ipk>|remove-app" >&2; exit 2 ;;
esac
