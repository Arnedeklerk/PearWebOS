#!/usr/bin/env python3
"""pear: install and manage PearWebOS on a rooted LG webOS TV.

    ./pear setup       find the TV, ask a few questions, install
    ./pear sync        push changed photos, settings and code (restarts Home only for code)
    ./pear photos      push the photos in photos/ (no restart)
    ./pear update      get the latest PearWebOS and put it on the TV
    ./pear status      what's running on the TV, and its version
    ./pear on | off    Pear Home, or LG's own Home
    ./pear shot        save a screenshot of the TV to docs/screenshot.jpg
    ./pear uninstall   remove PearWebOS from the TV

Most settings can also be changed on the TV: the cog at the top right of Home.
"""
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "installer"))

import install  # noqa: E402
from remote import HOOK, OLD_HOOKS, PEAR, TV_DIR, find_tvs, preflight, pull, ssh  # noqa: E402

CONF = os.path.join(HERE, ".pear.json")

# the line under the greeting (the same styles as in PearHome.qml)
DATE_STYLES = [("intl", "Tuesday 20 October"), ("us", "Tuesday, October 20"),
               ("short", "Tue, Oct 20"), ("ordinal", "Tue, Oct 20th")]
# small touches, asked in setup: (key, question)
TOUCHES = [
    ("entrance", "Greeting and dock rise in when Home appears?"),
    ("quiet", "After 45 seconds untouched, fade the dock away and leave the photo and clock (kinder to OLEDs)?"),
    ("drift", "Photo slowly zooms in and out (keeps the TV redrawing; can stutter on some sets)?"),
]
DEFAULTS = {"tv": "", "name": "", "clock": "24", "date": "intl", "wallpaper_quality": "light",
            "entrance": True, "quiet": True, "drift": False, "hidden": None,
            "weather": {"on": False, "place": "", "lat": None, "lon": None, "units": "c"},
            "guard": True, "boot_to_home": True, "quick_start": True, "no_update_prompt": True}


def load():
    conf = json.loads(json.dumps(DEFAULTS))
    if os.path.exists(CONF):
        with open(CONF) as f:
            conf.update(json.load(f))
    return conf


def save(conf):
    with open(CONF, "w") as f:
        json.dump(conf, f, indent=2)


def ask(prompt, default):
    shown = {True: "Y/n", False: "y/N"}.get(default, default)
    a = input(f"  {prompt} [{shown}] ").strip()
    if isinstance(default, bool):
        return default if not a else a.lower().startswith("y")
    return a or default


def ask_date(current):
    print("  Date style:")
    for i, (_, example) in enumerate(DATE_STYLES, 1):
        print(f"    {i}. {example}")
    keys = [d[0] for d in DATE_STYLES]
    a = ask("Which one", str(keys.index(current) + 1) if current in keys else "1")
    return keys[int(a) - 1] if a.isdigit() and 1 <= int(a) <= len(keys) else (a if a in keys else keys[0])


def ask_weather(w):
    w = dict(w)
    w["on"] = ask("Show the weather by the date (from Open-Meteo, free)?", bool(w.get("on")))
    if not w["on"]:
        return w
    while True:
        town = ask("Town or city", w.get("place") or "")
        hit = install.find_place(town) if town else None
        if hit:
            print(f"    Found {hit['place']}.")
            w.update(hit)
            break
        print("    Couldn't find that one (or no internet); try another spelling.")
    w["units"] = "f" if ask("Celsius or Fahrenheit", "C" if w.get("units") != "f" else "F").lower().startswith("f") else "c"
    return w


# ---- commands ----

def cmd_setup():
    conf = load()
    print("PearWebOS setup\n")
    if not conf["tv"]:
        print("Looking for LG TVs on your network...")
        tvs = find_tvs()
        for ip, has_ssh in tvs:
            print(f"  {ip}{'  (SSH open)' if has_ssh else ''}")
        guess = next((ip for ip, s in tvs if s), tvs[0][0] if tvs else "")
        conf["tv"] = ask("TV address", guess)
    preflight(conf)
    release = ssh(conf, "grep -o '\"webos_release\": *\"[^\"]*\"' /var/run/nyx/os_info.json | cut -d'\"' -f4", check=False).strip()
    print(f"  Connected. webOS {release or '?'}" + ("" if release.startswith("6.") else
          "  (Pear is tested on webOS 6; on other versions it may refuse, safely)"))
    # answers changed on the TV become this run's defaults
    install.merge_from_tv(conf)

    print()
    conf["name"] = ask('Name for the greeting ("Good evening, ___"; blank for none)', conf["name"])
    conf["clock"] = "12" if "12" in ask("Clock: 24 or 12 hour", conf["clock"]) else "24"
    conf["date"] = ask_date(conf["date"])
    conf["weather"] = ask_weather(conf["weather"])
    q = ask("Photo quality: light (1600x900, lightest on the TV) or high (1920x1080, the most Home can show)",
            conf["wallpaper_quality"]).lower()
    conf["wallpaper_quality"] = "high" if q.startswith("h") else "light"
    for key, question in TOUCHES:
        conf[key] = ask(question, conf[key])
    conf["guard"] = not ask("Do you watch Live TV through an aerial or cable?", not conf["guard"])
    conf["boot_to_home"] = ask("Power on straight to Home?", conf["boot_to_home"])
    conf["quick_start"] = ask("Turn on Quick Start+ (power-on resumes Pear instantly)?", conf["quick_start"])
    conf["no_update_prompt"] = ask('Hide LG\'s "new software, update now?" prompt (an update can remove root)?', conf["no_update_prompt"])
    print()
    install.sync(conf, force=True)
    save(conf)
    print(f"\nDone. Put photos in photos/ and run {PEAR} photos to use them as backgrounds.\n"
          "Most settings can be changed on the TV too: the cog at the top right of Home.")


def cmd_sync():
    conf = load()
    preflight(conf)
    install.sync(conf)
    save(conf)


def cmd_photos():
    conf = load()
    preflight(conf)
    install.push_photos(conf)
    print("Done: Home picks them up within a minute.")


def cmd_update():
    r = subprocess.run(["git", "-C", HERE, "pull", "--ff-only"])
    if r.returncode != 0:
        sys.exit("Couldn't update this copy (local changes?). Nothing was sent to the TV.")
    # a fresh interpreter, so the new code does the syncing
    os.execv(sys.executable, [sys.executable, os.path.join(HERE, "pear"), "sync"])


def cmd_status():
    conf = load()
    preflight(conf)
    print(ssh(conf, f"{TV_DIR}/pearwebos status 2>&1", check=False).rstrip())
    on_tv = ssh(conf, f"cat {TV_DIR}/VERSION 2>/dev/null", check=False).strip() or "?"
    here = install.version()
    print(f"version: {on_tv} on the TV, {here} here" +
          ("" if on_tv == here else f"  (run {PEAR} sync to update the TV)"))


def cmd_simple(arg):
    conf = load()
    preflight(conf)
    print(ssh(conf, f"{TV_DIR}/pearwebos {arg} 2>&1", check=False).rstrip())


def cmd_shot():
    conf = load()
    preflight(conf)
    ssh(conf, f"{TV_DIR}/luna-send-n -n 1 luna://com.webos.service.capture/executeOneShot "
              "'{\"path\":\"/tmp/pear-shot.jpg\",\"method\":\"DISPLAY\",\"width\":1920,\"height\":1080,\"format\":\"JPEG\"}' >/dev/null")
    dest = os.path.join(HERE, "docs", "screenshot.jpg")
    pull(conf, "/tmp/pear-shot.jpg", dest)
    print(f"Saved {os.path.relpath(dest)}")


def cmd_uninstall():
    conf = load()
    preflight(conf)
    print(ssh(conf, f"[ -x {TV_DIR}/pearwebos ] && {TV_DIR}/pearwebos off 2>&1 | tail -1; "
                    f"rm -f {HOOK} {' '.join(OLD_HOOKS)}; rm -rf {TV_DIR}; echo 'PearWebOS removed; LG Home is back.'", check=False).strip())
    print("Settings Pear changed (power-on screen, Quick Start+, update prompt) are left as they are;\n"
          "change them back in the TV's own Settings if you want.")


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "help"
    try:
        {"setup": cmd_setup, "sync": cmd_sync, "photos": cmd_photos, "update": cmd_update,
         "status": cmd_status, "shot": cmd_shot, "uninstall": cmd_uninstall,
         "on": lambda: cmd_simple("on"), "off": lambda: cmd_simple("off")
         }.get(cmd, lambda: print(__doc__.replace("./pear", PEAR)))()
    except KeyboardInterrupt:
        print()
